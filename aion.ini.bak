# AION2 external overlay configuration.
#
# Every setting here can also be changed in the INSERT menu, and the menu's
# "Save settings" row writes this file back in place - it rewrites the key=value lines
# only, so these comments and any key it does not know survive. A key that is missing
# falls back to its shipped default, so deleting a line is safe.
#
# Data the overlay accumulates lives in aion_names.txt next to the exe: the learned
# model -> name cache, filled in by playing or by --harvest-plates. Everything else -
# the lists, the colours, the name rules - is a setting below, edited in the menu or
# here.

# --- ESP -----------------------------------------------------------------
# Master switch. With it off nothing is drawn at all.
esp_enabled=1
esp_box=1
# 1 = an L bracket at each corner (leaves the sides open, so the box stops competing with
# the character and its own labels), 0 = a closed rectangle.
esp_box_corners=1
# Bracket arm length as a share of the box's short side (clamped to half, so two corners
# can never meet and re-form an outline).
esp_corner_frac=0.22
esp_name=1
esp_distance=1
esp_class=1
# Off-screen markers: an arrow pinned to the screen border pointing at anything nearby
# that the camera is not showing (behind you, or outside the viewport). A box in screen
# space has nothing to draw for those - a point behind the camera has no screen position
# at all - so without this they are invisible until you turn the camera onto them.
esp_offscreen=1
# How far those markers reach, in metres, from your character. Deliberately shorter than
# max_distance_m: a marker is read without turning, so a long reach is a frame of arrows.
offscreen_range_m=60
# Draw a snapline to each off-screen marker, from the same origin the box snaplines use.
# The arrow says which way to turn; the line is what makes one marker findable when
# several share an edge. Needs esp_snapline set to anything but off.
esp_offscreen_snapline=1
# Snapline origin: off, bottom, player, top. bottom/top start at the midpoint of that
# screen edge; player starts on your own character's box centre, so the line stays
# attached to the character while the camera pans - an edge-anchored one slides sideways
# with the view. 1/0 (the old on/off) still read as bottom/off. Also a menu row.
esp_snapline=player
# The hunting list as a category of its own: paint the actors on list_target in the
# drop colour and keep them drawn when their own category is off.
esp_target=1
# Diagnostic: log a per-entity dump and show the on-screen performance panel.
esp_debug=0
# Range limit in metres, measured from your character - not from the camera, which sits
# behind and above you and would overstate every distance by the zoom level.
max_distance_m=200
# Box and snapline stroke width in pixels. The stroke is feathered, so 1.0 is
# a solid pixel and 0.5 is half the colour; anything under about 0.5 reads as invisible on
# a bright screen. 1.0 is the default.
esp_thickness=1
# ESP text size: 1.0 = the atlas' native pixel size (drawn 1:1, never resampled).
esp_text_scale=1
# ESP label font em height in pixels at a 1080p-tall client (8..32). The glyph atlas is
# rasterized at exactly the size it is drawn at, so this is a crisp pixel size, not a
# scaled one. Changing it rebuilds the atlas.
esp_font_px=14
# Follow the client's height with the label size: esp_font_px is the size at 1080p and
# is rasterized larger on a taller frame (1440p -> x1.33, 4K -> x2), never smaller. Turn
# it off to use esp_font_px literally on every client.
esp_font_auto=1
# Font em height for the menu panel.
menu_font_px=16
font_face=Segoe UI
font_bold=0
# 1px black drop shadow behind labels: keeps them readable over anything.
text_shadow=1
# Skip characters the client itself marks dead (AionCharAnimInstance::bDead, read by
# reflection). The death is latched - the client clears bDead when the death animation
# ends, with the body still lying in the level - and released when the character has a
# movement mode again. A failed read is never treated as dead. Off: corpses stay drawn.
hide_dead=1
# Hide your own character: it is the one actor you are standing inside.
filter_local_player=1
# Draw limit per frame. The entity list is distance sorted, so the near ones win.
max_entities_drawn=512
# --- categories -----------------------------------------------------------
# What is drawn at all, independent of the master switch and of the ESP
# box/label rows. Players, NPCs, pets and drops are off by default: in a town
# they are most of the actor list and they drown out what this is for.
cat_player=1
cat_npc=0
cat_pet=0
cat_monster=1
cat_item=0
cat_gather=1
cat_interact=1
# Reward/hidden cubes: yellow like drops, a category of their own.
cat_cube=1
# Containers the client still reports as unopened - a chest you have not opened
# yet, in amber. One that has been opened is not drawn at all, and one whose
# state cannot be read is left visible rather than silently dropped.
cat_chest=1
cat_portal=1
cat_object=0
cat_other=0
# --- colours --------------------------------------------------------------
# RRGGBB (a leading # or 0x is accepted). One per category plus the two
# list colours: box, label and snapline of an actor are all drawn in its
# category's colour. The menu's Colours section walks a named preset with
# LEFT/RIGHT and opens R/G/B with ENTER. A value that is not six hex digits
# is ignored, which leaves the shipped default in place.
color_player=00FF00
color_npc=00DCFF
color_pet=96FF96
color_monster=FF9696
# everything in list_boss
color_boss=FF3C3C
# the drop colour: everything in list_target
color_target=FFDC00
color_item=FFDC00
color_gather=AA82FF
color_interact=FF00FF
color_cube=FFDC00
color_chest=FFA033
color_portal=FFFFFF
color_object=C8C8C8
color_other=8C8C8C
# actors the client is not rendering (see esp_hidden)
color_hidden=8A8A8A
# Label text. The four label colours live here rather than in the renderer,
# so the menu can offer them: color_label is the name line,
# color_distance the distance line, color_class the class line, and
# color_class_all the class line under SHOW ALL (the real UObject class).
color_label=FFFFFF
color_distance=FFFF00
color_class=78C8FF
color_class_all=FFBE50
# --- class lists ----------------------------------------------------------
# Comma-separated case-insensitive substrings, checked BEFORE the built-in
# patterns against the class name, then the object name, then the model.
# Use the menu's "Dump actor classes" to see the live names to pin.
list_player=
list_npc=
list_pet=
list_monster=
list_item=
list_gather=
list_cube=
list_interact=
list_ignore=
# Declared bosses and mini-bosses, matched EXACTLY (case-insensitive whole name) against
# the model first, then the object name, the ESP label and the class - any of them works,
# but a whole name must match: "Contaminated Swarm" does not claim
# "Contaminated Swarm Egg". Nothing the client exposes says which
# monster attacks unprovoked (aggro is the server's decision, and no rank survives in the
# object names or the dumps), so the rank is declared. Bosses are drawn in color_boss.
list_boss=
# The monsters you are hunting: the same exact whole-name matching as list_boss, painted in
# color_target, the drop colour, so "what I came for" reads the way loot does. An entry on
# both lists takes this colour.
list_target=
# Classes or mesh assets that are NEVER drawn, not even in SHOW ALL (comma-separated
# substrings, matched against both). Chests, lootboxes, bags and the rest of the
# container family are already hidden this way, so this is for everything else - the
# controller, projectile and footstep actors are hidden by default too.
never_show=
# Display names: pattern=Display Name, entries separated by ';'. UE names every spawned
# actor after its class, so the ESP shows the mesh asset instead (MOB_WindEle_01); this
# maps it onto the real name. The pattern is matched against the model, then the object
# name and the class name. A forced name rule (below) and a learned name in
# aion_names.txt both win over this mapping.
name_map=
# What each model's label is, one entry per rule, ';' between them - the menu edits these
# as rows and this line is what it writes. 'force:pattern=Label' always shows that label;
# 'auto:pattern' never takes a label from storage, showing the name the client reports
# live instead; 'hide:pattern' draws the entity but never its name. A trailing '*' on a
# pattern covers the whole family of models starting with it (portals need it: their model
# changes between runs). A ';' or '=' inside a pattern or a label is written as a space.
name_rules=
# Learned names: this table is keyed by the model (mesh), and it is what covers the actors
# the client builds no nameplate for - measured, it builds none beyond roughly 25 m. A
# name the client reveals for one actor is written here and applied to every instance of
# that model, at any distance; where the client does name an actor itself, its own name
# wins, which is the only way two monsters sharing one mesh are told apart. Fill it in one
# pass with:  aion_external.exe --harvest-plates
# A cache, not a setting: the rules above decide what is shown, and what the client
# reports wins over anything learned while an auto rule covers the model.
names_file=aion_names.txt
# --- performance ---------------------------------------------------------
# Seconds to wait for the AION2 client and its runtime objects (GNames, then
# GObjects a few seconds later) before giving up on the attach. Starting
# the overlay early is normal; 0 disables the wait.
sdk_wait_seconds=60
# ESP update rate. -1 (default) = uncapped: present every frame, so the frame the
# compositor picks is never older than one iteration. 0 = follow the display's refresh
# rate (lighter on CPU; a 60 fps overlay on a 144 Hz panel visibly trails the camera).
# >0 = that many updates per second.
present_fps=-1
# GPU composition present path (fast). 0 forces the UpdateLayeredWindow fallback.
overlay_dcomp=1
# Block in Present until vblank (0 = lowest latency).
overlay_vsync=0
# Idle (and hide) while the game window is not in the foreground: alt-tabbing to a
# browser, a launcher or the desktop hides the window outright, and it comes back with
# the game. Also a menu row.
skip_when_unfocused=1
# Diagnostic: draw EVERY actor (scenery, volumes, nav splines included) and label it with
# its real class name instead of the category, so unknown actor types can be identified
# in-game. Use max_distance_m and the draw limit to control the clutter.
esp_show_all=0
# Mirror the log into the session log next to the exe.
log_to_file=0
# Draw the actors the client is NOT rendering. bHidden alone is NOT that flag - measured
# with --dump-gates, the client sets it on actors it IS drawing - so the gate is 'bHidden
# and the renderer did not draw it', and a read failure never hides an actor. 0 (default)
# leaves those actors out. Measured on the live client, the game itself draws characters
# to about 45 m and nothing past 128 m; these are drawn in color_hidden instead, so a
# ESP still reaches past what the game shows.
esp_hidden=0
# How far those reach, in metres. Only used while esp_hidden is on.
hidden_range_m=600
# Your own health, as a STATE: ok / LOW / unknown (never a percentage, because this client
# exposes no HP/MP number to an outside reader - see build/self_hpmp_final.md). The state
# comes from the client's own low-health warning on your character; 'unknown' means that
# bit could not be read and is never shown as 0. If a patch ever exposes the HUD bar's
# ratio, the same readout draws a bar and a percentage instead, and a value read on an
# earlier frame is kept and marked '?'.
self_vitals=0
# Where the readout sits: 0 top-left, 1 top-right, 2 bottom-left, 3 bottom-right.
self_vitals_corner=0
# Panel width in pixels.
self_vitals_width=180
# Gap between the panel and the frame's edge, in pixels.
self_vitals_margin_px=16
# The panel behind the readout.
color_self_bg=0A0A10
# The HP state (and the bar, if a ratio is ever exposed).
color_self_hp=E05050
# The MP row (and its bar, if a ratio is ever exposed).
color_self_mp=5080E0
